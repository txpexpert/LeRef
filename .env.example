# --- Supabase (projet dédié à la plateforme) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publique : sert UNIQUEMENT à l'authentification (connexion, inscription).
# Aucune table n'est lisible avec cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : serveur uniquement (Vercel), jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://guides.exemple.ma

# --- Anti-robots à l'inscription et à la connexion (facultatif, Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Émetteur des factures ---
FACTURE_RAISON_SOCIALE=Structura Capital Investments
FACTURE_FORME=SARL
FACTURE_ADRESSE=Adresse à compléter
FACTURE_VILLE=Casablanca
FACTURE_ICE=000000000000000
FACTURE_RC=
FACTURE_IF=
FACTURE_TP=
FACTURE_BANQUE=Banque à compléter
FACTURE_RIB=000 000 0000000000000000 00
FACTURE_EMAIL=facturation@exemple.ma
